# Stark Card environment template
# Copy this file to the appropriate runtime location and replace all placeholders.

# Environment selector
# Set this before launching Django: development, test, staging, production
DJANGO_ENV=development

# Core secrets
SECRET_KEY=CHANGE_ME
THIRD_PARTY_API_FERNET_KEY=CHANGE_ME
DEBUG=False

# Host and origin allowlists
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTPS / proxy behavior
USE_HTTPS=False
USE_SECURE_PROXY_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=False
CSRF_COOKIE_SAMESITE=Lax

# Email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=cardstark98@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=cardstark98@gmail.com
SERVER_EMAIL=cardstark98@gmail.com

# Database
USE_SQLITE=1
DB_ENGINE=django.db.backends.postgresql
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# Frontend origin used by backend links / redirects
FRONTEND_URL=http://localhost:3000
